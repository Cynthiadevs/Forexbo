# ==========================================
# AI Forex Intelligence & Automation Platform
# ==========================================

# Application Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DEMO_MODE=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://forex_user:forex_password@localhost:5432/forex_ai_db?schema=public"
# Alternative SQLite for zero-config demo / test environments:
# DATABASE_URL="file:./dev.db"

# Redis & Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_DAILY_BUDGET_USD=10.00
AI_FALLBACK_TO_TEMPLATES=true

# Telegram Bot & Automation
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_DEFAULT_CHANNEL_ID=@your_forex_signals_channel

# Market Data Providers
# Supported: DEMO, POLYGON, ALPHAVANTAGE, OANDA, TWELVEDATA
MARKET_DATA_PROVIDER=DEMO
MARKET_DATA_API_KEY=your_market_data_api_key_here
MARKET_DATA_API_URL=https://api.polygon.io/v2
MARKET_POLLING_INTERVAL_MS=5000

# News & Economic Calendar API
NEWS_API_PROVIDER=DEMO
NEWS_API_KEY=your_news_api_key_here

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_987654321
JWT_REFRESH_EXPIRES_IN=7d

# Branding & Media Rendering
BRAND_NAME="ALPHA QUANT FX"
BRAND_WEBSITE="https://alphaquantfx.io"
BRAND_TELEGRAM="@AlphaQuantFX"
BRAND_PRIMARY_COLOR="#00E676"
BRAND_SECONDARY_COLOR="#0A0F1D"
BRAND_ACCENT_COLOR="#00B0FF"
BRAND_DISCLAIMER="For educational purposes only. Forex trading carries high risk."

# Admin Initial Seed
ADMIN_EMAIL=admin@alphaquantfx.io
ADMIN_PASSWORD=AdminSecurePassword123!
